    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module",
            "type": "python",
            "request": "launch",
            "module": "bmlsa.cli",
            "args": [
                "-I",
                "id",
                "-S",
                "sequence",
                "-B",
                "BLASTp",
                "${workspaceFolder}/tests/resources/SARS_CoV-2_genes.csv",
                "${workspaceFolder}/tests/resources/NC_045512_coding.fasta",
                "${workspaceFolder}/output"
            ],
            "justMyCode": true
        }
    ]
}